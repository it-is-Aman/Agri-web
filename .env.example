# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Leave a value empty to hide it on the site.

# ── Business identity ──────────────────────────────────────────
NEXT_PUBLIC_NAME_ENGLISH=AgriTools
NEXT_PUBLIC_NAME_HINDI=एग्रीटूल्स
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_YEAR_ESTABLISHED=2014

# ── Contact ────────────────────────────────────────────────────
# Phone: any format works ("+91 98765 43210" or "9876543210"); 10-digit numbers get +91 added
NEXT_PUBLIC_PHONE=919999999999
NEXT_PUBLIC_WHATSAPP=919999999999
NEXT_PUBLIC_EMAIL=info@example.com

# ── Address ────────────────────────────────────────────────────
NEXT_PUBLIC_ADDRESS_LINE=Shop No. __, Sector __
NEXT_PUBLIC_CITY=Noida
NEXT_PUBLIC_STATE=Uttar Pradesh
NEXT_PUBLIC_PINCODE=201301
NEXT_PUBLIC_MAP_EMBED_URL=
NEXT_PUBLIC_SHOP_HOURS=Mon–Sat, 9:30 AM – 7:30 PM

# ── Registration & certifications (placeholders until shared) ─
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_UDYAM_NUMBER=
NEXT_PUBLIC_IEC_CODE=

# ── Catalogue (Google Sheet) ───────────────────────────────────
# Google Sheet → File → Share → Publish to web → choose the tab → CSV → copy link.
# Empty = site uses the built-in sample catalogue. See docs/PRICE_SHEET.md
PRODUCTS_SHEET_CSV_URL=
# How often (seconds) the site re-reads the sheet
CATALOG_REVALIDATE_SECONDS=300
